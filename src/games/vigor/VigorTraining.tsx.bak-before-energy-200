function randomItem<T>(
  values: T[]
): T {
  return values[
    Math.floor(
      Math.random() *
      values.length
    )
  ]
}

function getSizeMultiplier(
  size: AttackSize
) {
  if (size === 'small') {
    return 0.75
  }

  if (size === 'large') {
    return 1.4
  }

  return 1
}

function getSizeScale(
  size: AttackSize
) {
  if (size === 'small') {
    return 0.78
  }

  if (size === 'large') {
    return 1.35
  }

  return 1
}

function getAttackPool(
  wave: number
) {
  if (wave <= 8) {
    return ATTACKS.filter(
      (attack) =>
        attack.type === 'arrow' ||
        attack.type === 'fireball' ||
        attack.type === 'mana' ||
        attack.type === 'wind'
    )
  }

  if (wave <= 20) {
    return ATTACKS.filter(
      (attack) =>
        attack.type !== 'heavy'
    )
  }

  return ATTACKS
}

function getProjectileCount(
  wave: number
) {
  if (wave <= 8) {
    return 1
  }

  if (wave <= 18) {
    return Math.random() < 0.6
      ? 1
      : 2
  }

  if (wave <= 32) {
    return Math.random() < 0.45
      ? 2
      : 3
  }

  return Math.random() < 0.5
    ? 3
    : 4
}

function getAttackSize(
  wave: number
): AttackSize {
  const roll =
    Math.random()

  if (wave <= 12) {
    if (roll < 0.25) {
      return 'small'
    }

    if (roll < 0.92) {
      return 'normal'
    }

    return 'large'
  }

  if (roll < 0.22) {
    return 'small'
  }

  if (roll < 0.7) {
    return 'normal'
  }

  return 'large'
}

function distance(
  x1: number,
  y1: number,
  x2: number,
  y2: number
) {
  const dx = x1 - x2
  const dy = y1 - y2

  return Math.sqrt(
    dx * dx +
    dy * dy
  )
}

export function VigorTraining() {
  const {
    currentStacks,
    targetStacks,
    addStack,
    resetProgress,
    returnToMenu,
  } = useTrainingStore()

  const [
    phase,
    setPhase,
  ] = useState<GamePhase>(
    'ready'
  )

  const [
    countdown,
    setCountdown,
  ] = useState(3)

  const [
    life,
    setLife,
  ] = useState(MAX_LIFE)

  const [
    energy,
    setEnergy,
  ] = useState(MAX_ENERGY)

  const [
    projectiles,
    setProjectiles,
  ] = useState<
    Projectile[]
  >([])

  const [
    physicalGuard,
    setPhysicalGuard,
  ] = useState(false)

  const [
    magicDirection,
    setMagicDirection,
  ] = useState<
    AttackDirection | null
  >(null)

  const [
    barrierActive,
    setBarrierActive,
  ] = useState(false)

  const [
    waveNumber,
    setWaveNumber,
  ] = useState(0)

  const [
    feedback,
    setFeedback,
  ] = useState<
    string | null
  >(null)

  const [
    feedbackDamage,
    setFeedbackDamage,
  ] = useState<
    number | null
  >(null)

  const [
    impactFlash,
    setImpactFlash,
  ] = useState(false)

  const [
    lastAttack,
    setLastAttack,
  ] = useState<
    AttackDefinition | null
  >(null)

  const arenaRef =
    useRef<
      HTMLDivElement | null
    >(null)

  const phaseRef =
    useRef<GamePhase>(
      'ready'
    )

  const lifeRef =
    useRef(MAX_LIFE)

  const energyRef =
    useRef(MAX_ENERGY)

  const physicalGuardRef =
    useRef(false)

  const magicDirectionRef =
    useRef<
      AttackDirection | null
    >(null)

  const barrierActiveRef =
    useRef(false)

  const barrierUntilRef =
    useRef(0)

  const regenBlockedUntilRef =
    useRef(0)

  const projectileIdRef =
    useRef(0)

  const projectilesRef =
    useRef<
      Projectile[]
    >([])

  const animationRef =
    useRef<
      number | null
    >(null)

  const lastFrameRef =
    useRef<
      number | null
    >(null)

  const waveActiveRef =
    useRef(false)

  const nextWaveAtRef =
    useRef(0)

  const wavesSurvivedRef =
    useRef(0)

  const progress =
    targetStacks > 0
      ? (
          currentStacks /
          targetStacks
        ) * 100
      : 0

  const lifePercent =
    (
      life /
      MAX_LIFE
    ) * 100

  const energyPercent =
    (
      energy /
      MAX_ENERGY
    ) * 100

  useEffect(() => {
    phaseRef.current =
      phase
  }, [phase])

  /*
  =========================================================
  FEEDBACK
  =========================================================
  */

  const showFeedback =
    useCallback(
      (
        message: string,
        damage:
          number | null = null
      ) => {
        setFeedback(message)

        setFeedbackDamage(
          damage
        )

        window.setTimeout(
          () => {
            setFeedback(null)
            setFeedbackDamage(null)
          },
          460
        )
      },
      []
    )

  const triggerImpact =
    useCallback(() => {
      setImpactFlash(true)

      window.setTimeout(
        () => {
          setImpactFlash(false)
        },
        150
      )
    }, [])

  /*
  =========================================================
  DEFESA FÍSICA
  =========================================================
  */

  const startPhysicalGuard =
    useCallback(() => {
      if (
        phaseRef.current !==
        'playing'
      ) {
        return
      }

      if (
        magicDirectionRef.current
      ) {
        magicDirectionRef.current =
          null

        setMagicDirection(
          null
        )

        regenBlockedUntilRef.current =
          performance.now() +
          MAGIC_REGEN_DELAY
      }

      physicalGuardRef.current =
        true

      setPhysicalGuard(true)
    }, [])

  const stopPhysicalGuard =
    useCallback(() => {
      physicalGuardRef.current =
        false

      setPhysicalGuard(false)
    }, [])

  /*
  =========================================================
  DEFESA MÁGICA
  =========================================================
  */

  const startMagicGuard =
    useCallback(
      (
        direction:
          AttackDirection
      ) => {
        if (
          phaseRef.current !==
          'playing'
        ) {
          return
        }

        physicalGuardRef.current =
          false

        setPhysicalGuard(false)

        magicDirectionRef.current =
          direction

        setMagicDirection(
          direction
        )
      },
      []
    )

  const stopMagicGuard =
    useCallback(
      (
        direction?:
          AttackDirection
      ) => {
        if (
          direction &&
          magicDirectionRef.current !==
            direction
        ) {
          return
        }

        if (
          magicDirectionRef.current
        ) {
          regenBlockedUntilRef.current =
            performance.now() +
            MAGIC_REGEN_DELAY
        }

        magicDirectionRef.current =
          null

        setMagicDirection(null)
      },
      []
    )

  /*
  =========================================================
  BARREIRA
  =========================================================
  */

  const activateBarrier =
    useCallback(() => {
      if (
        phaseRef.current !==
        'playing'
      ) {
        return
      }

      if (
        barrierActiveRef.current
      ) {
        return
      }

      if (
        energyRef.current <
        BARRIER_COST
      ) {
        showFeedback(
          'ENERGIA INSUFICIENTE'
        )

        return
      }

      const now =
        performance.now()

      physicalGuardRef.current =
        false

      magicDirectionRef.current =
        null

      setPhysicalGuard(false)
      setMagicDirection(null)

      energyRef.current =
        Math.max(
          0,
          energyRef.current -
          BARRIER_COST
        )

      setEnergy(
        energyRef.current
      )

      barrierActiveRef.current =
        true

      barrierUntilRef.current =
        now +
        BARRIER_DURATION

      regenBlockedUntilRef.current =
        now +
        BARRIER_DURATION +
        MAGIC_REGEN_DELAY

      setBarrierActive(true)

      showFeedback(
        'BARREIRA!'
      )
    }, [showFeedback])

  /*
  =========================================================
  RESET
  =========================================================
  */

  const resetGame =
    useCallback(() => {
      resetProgress()

      lifeRef.current =
        MAX_LIFE

      energyRef.current =
        MAX_ENERGY

      setLife(MAX_LIFE)
      setEnergy(MAX_ENERGY)

      physicalGuardRef.current =
        false

      magicDirectionRef.current =
        null

      barrierActiveRef.current =
        false

      setPhysicalGuard(false)
      setMagicDirection(null)
      setBarrierActive(false)

      barrierUntilRef.current =
        0

      regenBlockedUntilRef.current =
        0

      projectileIdRef.current =
        0

      projectilesRef.current =
        []

      setProjectiles([])

      waveActiveRef.current =
        false

      nextWaveAtRef.current =
        0

      wavesSurvivedRef.current =
        0

      setWaveNumber(0)

      setLastAttack(null)

      lastFrameRef.current =
        null

      setFeedback(null)

      setFeedbackDamage(
        null
      )

      setImpactFlash(false)
    }, [resetProgress])

  const startGame = () => {
    resetGame()

    setCountdown(3)

    setPhase(
      'countdown'
    )
  }

  /*
  =========================================================
  CONTAGEM
  =========================================================
  */

  useEffect(() => {
    if (
      phase !== 'countdown'
    ) {
      return
    }

    if (
      countdown <= 0
    ) {
      const timer =
        window.setTimeout(
          () => {
            setPhase(
              'playing'
            )

            nextWaveAtRef.current =
              performance.now() +
              450
          },
          300
        )

      return () => {
        window.clearTimeout(
          timer
        )
      }
    }

    const timer =
      window.setTimeout(
        () => {
          setCountdown(
            (value) =>
              value - 1
          )
        },
        650
      )

    return () => {
      window.clearTimeout(
        timer
      )
    }
  }, [
    phase,
    countdown,
  ])

  /*
  =========================================================
  PROJÉTEIS
  =========================================================
  */

  const createProjectile =
    useCallback(
      (
        direction:
          AttackDirection,

        wave: number
      ): Projectile | null => {
        const arena =
          arenaRef.current

        if (!arena) {
          return null
        }

        const width =
          arena.clientWidth

        const height =
          arena.clientHeight

        const centerX =
          width / 2

        const centerY =
          height / 2

        const attack =
          randomItem(
            getAttackPool(
              wave
            )
          )

        const size =
          getAttackSize(
            wave
          )

        const scale =
          getSizeScale(
            size
          )

        const multiplier =
          getSizeMultiplier(
            size
          )

        const radius =
          attack.radius *
          scale

        const damage =
          Math.max(
            1,
            Math.round(
              attack.damage *
              multiplier
            )
          )

        const guardDamage =
          Math.max(
            1,
            Math.round(
              attack.guardDamage *
              multiplier
            )
          )

        const margin =
          radius + 45

        let x =
          centerX

        let y =
          centerY

        if (
          direction ===
          'top'
        ) {
          x =
            width *
            (
              0.18 +
              Math.random() *
              0.64
            )

          y =
            -margin
        }

        if (
          direction ===
          'bottom'
        ) {
          x =
            width *
            (
              0.18 +
              Math.random() *
              0.64
            )

          y =
            height +
            margin
        }

        if (
          direction ===
          'left'
        ) {
          x =
            -margin

          y =
            height *
            (
              0.18 +
              Math.random() *
              0.64
            )
        }

        if (
          direction ===
          'right'
        ) {
          x =
            width +
            margin

          y =
            height *
            (
              0.18 +
              Math.random() *
              0.64
            )
        }

        const dx =
          centerX - x

        const dy =
          centerY - y

        const length =
          Math.sqrt(
            dx * dx +
            dy * dy
          ) || 1

        projectileIdRef.current +=
          1

        return {
          id:
            projectileIdRef.current,

          attack,
          direction,
          size,

          x,
          y,

          vx:
            (
              dx /
              length
            ) *
            attack.speed,

          vy:
            (
              dy /
              length
            ) *
            attack.speed,

          radius,
          damage,
          guardDamage,
        }
      },
      []
    )

  /*
  =========================================================
  ONDAS
  =========================================================
  */

  const spawnWave =
    useCallback(() => {
      const wave =
        wavesSurvivedRef.current +
        1

      setWaveNumber(
        wave
      )

      const count =
        getProjectileCount(
          wave
        )

      const availableDirections =
        [...DIRECTIONS]

      const newProjectiles:
        Projectile[] = []

      for (
        let index = 0;
        index < count;
        index += 1
      ) {
        let direction:
          AttackDirection

        if (
          availableDirections.length >
          0
        ) {
          const directionIndex =
            Math.floor(
              Math.random() *
              availableDirections.length
            )

          direction =
            availableDirections[
              directionIndex
            ]

          availableDirections.splice(
            directionIndex,
            1
          )
        } else {
          direction =
            randomItem(
              DIRECTIONS
            )
        }

        const projectile =
          createProjectile(
            direction,
            wave
          )

        if (projectile) {
          newProjectiles.push(
            projectile
          )

          setLastAttack(
            projectile.attack
          )
        }
      }

      if (
        newProjectiles.length ===
        0
      ) {
        nextWaveAtRef.current =
          performance.now() +
          100

        return
      }

      projectilesRef.current =
        newProjectiles

      setProjectiles(
        newProjectiles
      )

      waveActiveRef.current =
        true
    }, [createProjectile])

  /*
  =========================================================
  LOOP PRINCIPAL
  =========================================================
  */

  useEffect(() => {
    if (
      phase !== 'playing'
    ) {
      if (
        animationRef.current !==
        null
      ) {
        cancelAnimationFrame(
          animationRef.current
        )
      }

      lastFrameRef.current =
        null

      return
    }

    const frame = (
      time: number
    ) => {
      const arena =
        arenaRef.current

      if (
        !arena ||
        phaseRef.current !==
          'playing'
      ) {
        return
      }

      if (
        lastFrameRef.current ===
        null
      ) {
        lastFrameRef.current =
          time
      }

      const delta =
        Math.min(
          (
            time -
            lastFrameRef.current
          ) / 1000,
          0.05
        )

      lastFrameRef.current =
        time

      const width =
        arena.clientWidth

      const height =
        arena.clientHeight

      const centerX =
        width / 2

      const centerY =
        height / 2

      /*
      BARREIRA ACABOU
      */

      if (
        barrierActiveRef.current &&
        time >=
          barrierUntilRef.current
      ) {
        barrierActiveRef.current =
          false

        setBarrierActive(
          false
        )
      }

      /*
      ======================================================
      REGENERAÇÃO CONTÍNUA DE ENERGIA

      Taxa:
      10 Energia por segundo

      Equivale a:
      0.01 Energia por milissegundo

      O requestAnimationFrame calcula a quantidade
      usando o tempo real passado entre frames.

      Defesa Física:
      continua recuperando.

      Defesa Mágica:
      pausa recuperação.

      Barreira:
      pausa recuperação.

      Depois de magia:
      mantém o delay já existente.
      ======================================================
      */

      const canRegenerate =
        !magicDirectionRef.current &&
        !barrierActiveRef.current &&
        time >=
          regenBlockedUntilRef.current

      if (
        canRegenerate &&
        energyRef.current <
          MAX_ENERGY
      ) {
        energyRef.current =
          Math.min(
            MAX_ENERGY,
            energyRef.current +
              ENERGY_REGEN_PER_SECOND *
              delta
          )

        setEnergy(
          energyRef.current
        )
      }

      /*
      NOVA ONDA
      */

      if (
        !waveActiveRef.current &&
        projectilesRef.current.length ===
          0 &&
        time >=
          nextWaveAtRef.current
      ) {
        spawnWave()
      }

      /*
      MOVIMENTO / COLISÕES
      */

      if (
        projectilesRef.current.length >
        0
      ) {
        const survivors:
          Projectile[] = []

        let playerDied =
          false

        for (
          const projectile of
          projectilesRef.current
        ) {
          const next = {
            ...projectile,

            x:
              projectile.x +
              projectile.vx *
              delta,

            y:
              projectile.y +
              projectile.vy *
              delta,
          }

          const playerDistance =
            distance(
              next.x,
              next.y,
              centerX,
              centerY
            )

          /*
          BARREIRA
          */

          if (
            barrierActiveRef.current &&
            playerDistance <=
              BARRIER_RADIUS +
              next.radius
          ) {
            showFeedback(
              'BLOQUEADO!'
            )

            continue
          }

          /*
          DEFESA MÁGICA
          */

          if (
            magicDirectionRef.current ===
              projectile.direction &&
            playerDistance <=
              MAGIC_INTERCEPT_DISTANCE +
              next.radius
          ) {
            if (
              energyRef.current >=
              MAGIC_BLOCK_COST
            ) {
              energyRef.current =
                Math.max(
                  0,
                  energyRef.current -
                    MAGIC_BLOCK_COST
                )

              setEnergy(
                energyRef.current
              )

              regenBlockedUntilRef.current =
                time +
                MAGIC_REGEN_DELAY

              showFeedback(
                'DEFESA MÁGICA!'
              )

              continue
            }

            showFeedback(
              'SEM ENERGIA!'
            )
          }

          /*
          PERSONAGEM
          */

          if (
            playerDistance <=
              PLAYER_RADIUS +
              next.radius
          ) {
            const damage =
              physicalGuardRef.current
                ? projectile.guardDamage
                : projectile.damage

            lifeRef.current =
              Math.max(
                0,
                lifeRef.current -
                  damage
              )

            setLife(
              lifeRef.current
            )

            triggerImpact()

            if (
              physicalGuardRef.current
            ) {
              showFeedback(
                'DEFESA FÍSICA',
                damage
              )
            } else {
              showFeedback(
                'ATINGIDO!',
                damage
              )
            }

            if (
              lifeRef.current <= 0
            ) {
              playerDied =
                true
            }

            continue
          }

          survivors.push(
            next
          )
        }

        if (
          playerDied
        ) {
          projectilesRef.current =
            []

          setProjectiles([])

          waveActiveRef.current =
            false

          setPhase(
            'failed'
          )

          return
        }

        projectilesRef.current =
          survivors

        setProjectiles(
          survivors
        )

        /*
        ONDA SOBREVIVIDA
        */

        if (
          waveActiveRef.current &&
          survivors.length ===
            0
        ) {
          waveActiveRef.current =
            false

          wavesSurvivedRef.current +=
            1

          addStack(1)

          if (
            wavesSurvivedRef.current >=
            targetStacks
          ) {
            setPhase(
