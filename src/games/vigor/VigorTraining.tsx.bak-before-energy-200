        KeyD: 'right',
      }

    const handleKeyDown = (
      event: KeyboardEvent
    ) => {
      if (
        event.code ===
          'ShiftLeft' ||
        event.code ===
          'ShiftRight'
      ) {
        event.preventDefault()

        startPhysicalGuard()

        return
      }

      const direction =
        directions[
          event.code
        ]

      if (direction) {
        event.preventDefault()

        startMagicGuard(
          direction
        )

        return
      }

      if (
        event.code ===
          'Space' &&
        !event.repeat
      ) {
        event.preventDefault()

        activateBarrier()
      }
    }

    const handleKeyUp = (
      event: KeyboardEvent
    ) => {
      if (
        event.code ===
          'ShiftLeft' ||
        event.code ===
          'ShiftRight'
      ) {
        event.preventDefault()

