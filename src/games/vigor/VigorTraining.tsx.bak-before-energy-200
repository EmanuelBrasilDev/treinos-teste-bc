type GamePhase =
  | 'ready'
  | 'countdown'
  | 'playing'
  | 'complete'
  | 'failed'

type AttackDirection =
  | 'top'
  | 'bottom'
  | 'left'
  | 'right'

type AttackSize =
  | 'small'
  | 'normal'
  | 'large'

type AttackType =
  | 'arrow'
  | 'fireball'
  | 'mana'
  | 'wind'
  | 'rock'
  | 'impact'
  | 'heavy'

interface AttackDefinition {
  type: AttackType
  name: string
  symbol: string
  damage: number
  guardDamage: number
  speed: number
  radius: number
  background: string
  glow: string
}

interface Projectile {
  id: number

  attack: AttackDefinition
  direction: AttackDirection
  size: AttackSize

  x: number
  y: number

  vx: number
  vy: number

  radius: number

  damage: number
  guardDamage: number
}

const MAX_LIFE = 200
const MAX_ENERGY = 150

const ENERGY_REGEN_PER_SECOND = 10

const MAGIC_BLOCK_COST = 5
const BARRIER_COST = 10

const BARRIER_DURATION = 800
const MAGIC_REGEN_DELAY = 600

/*
