                    tracking-[0.3em]
                    text-red-400
                  "
                >
                  Vida esgotada
                </p>

                <h2
                  className="
                    mt-2
                    text-3xl
                    font-black
                  "
                >
                  Treino falhou
                </h2>

                <p
                  className="
                    mt-3
                    text-sm
                    text-white/45
                  "
                >
                  Você chegou à onda
                  {' '}
                  <strong className="text-white">
                    {currentStacks}
                  </strong>
                  .
                </p>

                <button
                  type="button"
                  onClick={
                    startGame
                  }

                  className="
                    mt-7
                    flex
                    min-h-14
                    w-full
                    items-center
                    justify-center
                    gap-2
                    rounded-2xl
                    bg-emerald-400
                    font-black
                    text-black
                  "
                >
                  <RotateCcw
                    size={18}
                  />

                  Tentar Novamente
                </button>

                <button
                  type="button"
                  onClick={
                    exitTraining
                  }

                  className="
                    mt-3
                    min-h-14
                    w-full
                    rounded-2xl
                    border
                    border-white/10
                    bg-white/5
                    font-black
                  "
                >
                  Voltar aos Treinos
                </button>

              </motion.div>
            )}

          </AnimatePresence>

        </section>

      </div>

    </main>
  )
}
