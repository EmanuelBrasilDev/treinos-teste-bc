                      border-emerald-400/30
                    "
                  />

                  <Shield
                    size={50}
                    className="
                      text-emerald-300
                    "
                  />

                </div>

                <h2
                  className="
                    mt-5
                    text-3xl
                    font-black
                  "
                >
                  Resistência Extrema
                </h2>

                <p
                  className="
                    mt-3
                    max-w-sm
                    text-sm
