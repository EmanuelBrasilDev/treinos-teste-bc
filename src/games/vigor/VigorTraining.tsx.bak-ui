                    </p>
                  </div>

                  <div
                    className="
                      rounded-2xl
                      border
                      border-violet-400/20
                      bg-violet-400/[0.06]
                      p-3
                    "
                  >
                    <Sparkles
                      size={22}
                      className="
                        mx-auto
                        text-violet-300
