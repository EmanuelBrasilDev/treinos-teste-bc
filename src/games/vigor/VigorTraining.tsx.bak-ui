import {
  useCallback,
  useEffect,
  useRef,
  useState,
} from 'react'

import {
  AnimatePresence,
  motion,
} from 'motion/react'

import {
  ArrowDown,
  ArrowLeft,
  ArrowRight,
  ArrowUp,
  Heart,
  RotateCcw,
  Shield,
  Sparkles,
  Trophy,
  Zap,
} from 'lucide-react'

import { useTrainingStore } from '../../features/training/store/useTrainingStore'

type GamePhase =
  | 'ready'
  | 'countdown'
  | 'playing'
  | 'complete'
  | 'failed'

type AttackDirection =
  | 'top'
  | 'bottom'
  | 'left'
  | 'right'

type AttackSize =
  | 'small'
  | 'normal'
  | 'large'

type AttackType =
  | 'arrow'
  | 'fireball'
  | 'mana'
  | 'wind'
  | 'rock'
  | 'impact'
  | 'heavy'

interface AttackDefinition {
  type: AttackType
  name: string
  symbol: string
  damage: number
  guardDamage: number
  speed: number
  radius: number
  background: string
  glow: string
}

interface Projectile {
  id: number

  attack: AttackDefinition
  direction: AttackDirection
  size: AttackSize

  x: number
  y: number

  vx: number
  vy: number

  radius: number

  damage: number
  guardDamage: number
}

const MAX_LIFE = 100
const MAX_ENERGY = 100

const ENERGY_REGEN = 5

const MAGIC_BLOCK_COST = 8
const BARRIER_COST = 25

const BARRIER_DURATION = 800
const MAGIC_REGEN_DELAY = 600

/*
Personagem visualmente maior.

A hitbox continua menor que o desenho
para não deixar o jogo injusto.
*/

const PLAYER_RADIUS = 30
const MAGIC_INTERCEPT_DISTANCE = 105
const BARRIER_RADIUS = 112

const WAVE_DELAY = 650

const DIRECTIONS: AttackDirection[] = [
  'top',
  'bottom',
  'left',
  'right',
]

const ATTACKS: AttackDefinition[] = [
  {
    type: 'arrow',
    name: 'Flecha',
    symbol: '➶',
    damage: 10,
    guardDamage: 4,
    speed: 560,
    radius: 9,
    background: '#d6d3d1',
    glow: 'rgba(214,211,209,.75)',
  },

  {
    type: 'fireball',
    name: 'Bola de Fogo',
    symbol: '🔥',
    damage: 18,
    guardDamage: 8,
    speed: 390,
    radius: 15,
    background: '#f97316',
    glow: 'rgba(249,115,22,.85)',
  },

  {
    type: 'mana',
    name: 'Projétil de Mana',
    symbol: '✦',
    damage: 15,
    guardDamage: 6,
    speed: 440,
    radius: 13,
    background: '#a855f7',
    glow: 'rgba(168,85,247,.85)',
  },

  {
    type: 'wind',
    name: 'Lâmina de Vento',
    symbol: '◇',
    damage: 14,
    guardDamage: 7,
    speed: 600,
    radius: 11,
    background: '#22d3ee',
    glow: 'rgba(34,211,238,.85)',
  },

  {
    type: 'rock',
    name: 'Rocha',
    symbol: '◆',
    damage: 25,
    guardDamage: 12,
    speed: 310,
    radius: 20,
    background: '#78716c',
    glow: 'rgba(120,113,108,.85)',
  },

  {
    type: 'impact',
    name: 'Esfera de Impacto',
    symbol: '⚡',
    damage: 30,
    guardDamage: 16,
    speed: 390,
    radius: 21,
    background: '#eab308',
    glow: 'rgba(234,179,8,.9)',
  },

  {
    type: 'heavy',
    name: 'Rajada Pesada',
    symbol: '💥',
    damage: 40,
    guardDamage: 22,
    speed: 285,
    radius: 27,
    background: '#ef4444',
    glow: 'rgba(239,68,68,.9)',
  },
]

function randomItem<T>(
  values: T[]
): T {
  return values[
    Math.floor(
      Math.random() *
      values.length
    )
  ]
}

function getSizeMultiplier(
  size: AttackSize
) {
  if (size === 'small') {
    return 0.75
  }

  if (size === 'large') {
    return 1.4
  }

  return 1
}

function getSizeScale(
  size: AttackSize
) {
  if (size === 'small') {
    return 0.78
  }

  if (size === 'large') {
    return 1.35
  }

  return 1
}

function getAttackPool(
  wave: number
) {
  if (wave <= 8) {
    return ATTACKS.filter(
      (attack) =>
        attack.type === 'arrow' ||
        attack.type === 'fireball' ||
        attack.type === 'mana' ||
        attack.type === 'wind'
    )
  }

  if (wave <= 20) {
    return ATTACKS.filter(
      (attack) =>
        attack.type !== 'heavy'
    )
  }

  return ATTACKS
}

function getProjectileCount(
  wave: number
) {
  if (wave <= 8) {
    return 1
  }

  if (wave <= 18) {
    return Math.random() < 0.6
      ? 1
      : 2
  }

  if (wave <= 32) {
    return Math.random() < 0.45
      ? 2
      : 3
  }

  return Math.random() < 0.5
    ? 3
    : 4
}

function getAttackSize(
  wave: number
): AttackSize {
  const roll =
    Math.random()

  if (wave <= 12) {
    if (roll < 0.25) {
      return 'small'
    }

    if (roll < 0.92) {
      return 'normal'
    }

    return 'large'
  }

  if (roll < 0.22) {
    return 'small'
  }

  if (roll < 0.7) {
    return 'normal'
  }

  return 'large'
}

function distance(
  x1: number,
  y1: number,
  x2: number,
  y2: number
) {
  const dx = x1 - x2
  const dy = y1 - y2

  return Math.sqrt(
    dx * dx +
    dy * dy
  )
}

export function VigorTraining() {
  const {
    currentStacks,
    targetStacks,
    addStack,
    resetProgress,
    returnToMenu,
  } = useTrainingStore()

  const [
    phase,
    setPhase,
  ] = useState<GamePhase>(
    'ready'
  )

  const [
    countdown,
    setCountdown,
  ] = useState(3)

  const [
    life,
    setLife,
  ] = useState(MAX_LIFE)

  const [
    energy,
    setEnergy,
  ] = useState(MAX_ENERGY)

  const [
    projectiles,
    setProjectiles,
  ] = useState<
    Projectile[]
  >([])

  const [
    physicalGuard,
    setPhysicalGuard,
  ] = useState(false)

  const [
    magicDirection,
    setMagicDirection,
  ] = useState<
    AttackDirection | null
  >(null)

  const [
    barrierActive,
    setBarrierActive,
  ] = useState(false)

  const [
    waveNumber,
    setWaveNumber,
  ] = useState(0)

  const [
    feedback,
    setFeedback,
  ] = useState<
    string | null
  >(null)

  const [
    feedbackDamage,
    setFeedbackDamage,
  ] = useState<
    number | null
  >(null)

  const [
    impactFlash,
    setImpactFlash,
  ] = useState(false)

  const [
    lastAttack,
    setLastAttack,
  ] = useState<
    AttackDefinition | null
  >(null)

  const arenaRef =
    useRef<
      HTMLDivElement | null
    >(null)

  const phaseRef =
    useRef<GamePhase>(
      'ready'
    )

  const lifeRef =
    useRef(MAX_LIFE)

  const energyRef =
    useRef(MAX_ENERGY)

  const physicalGuardRef =
    useRef(false)

  const magicDirectionRef =
    useRef<
      AttackDirection | null
    >(null)

  const barrierActiveRef =
    useRef(false)

  const barrierUntilRef =
    useRef(0)

  const regenBlockedUntilRef =
    useRef(0)

  const projectileIdRef =
    useRef(0)

  const projectilesRef =
    useRef<
      Projectile[]
    >([])

  const animationRef =
    useRef<
      number | null
    >(null)

  const lastFrameRef =
    useRef<
      number | null
    >(null)

  const waveActiveRef =
    useRef(false)

  const nextWaveAtRef =
    useRef(0)

  const wavesSurvivedRef =
    useRef(0)

  const progress =
    targetStacks > 0
      ? (
          currentStacks /
          targetStacks
        ) * 100
      : 0

  useEffect(() => {
    phaseRef.current =
      phase
  }, [phase])

  /*
  =========================================================
  FEEDBACK
  =========================================================
  */

  const showFeedback =
    useCallback(
      (
        message: string,
        damage:
          number | null = null
      ) => {
        setFeedback(message)

        setFeedbackDamage(
          damage
        )

        window.setTimeout(
          () => {
            setFeedback(null)
            setFeedbackDamage(null)
          },
          460
        )
      },
      []
    )

  const triggerImpact =
    useCallback(() => {
      setImpactFlash(true)

      window.setTimeout(
        () => {
          setImpactFlash(false)
        },
        150
      )
    }, [])

  /*
  =========================================================
  DEFESA FÍSICA
  =========================================================
  */

  const startPhysicalGuard =
    useCallback(() => {
      if (
        phaseRef.current !==
        'playing'
      ) {
        return
      }

      if (
        magicDirectionRef.current
      ) {
        magicDirectionRef.current =
          null

        setMagicDirection(
          null
        )

        regenBlockedUntilRef.current =
          performance.now() +
          MAGIC_REGEN_DELAY
      }

      physicalGuardRef.current =
        true

      setPhysicalGuard(true)
    }, [])

  const stopPhysicalGuard =
    useCallback(() => {
      physicalGuardRef.current =
        false

      setPhysicalGuard(false)
    }, [])

  /*
  =========================================================
  DEFESA MÁGICA
  =========================================================
  */

  const startMagicGuard =
    useCallback(
      (
        direction:
          AttackDirection
      ) => {
        if (
          phaseRef.current !==
          'playing'
        ) {
          return
        }

        physicalGuardRef.current =
          false

        setPhysicalGuard(false)

        magicDirectionRef.current =
          direction

        setMagicDirection(
          direction
        )
      },
      []
    )

  const stopMagicGuard =
    useCallback(
      (
        direction?:
          AttackDirection
      ) => {
        if (
          direction &&
          magicDirectionRef.current !==
            direction
        ) {
          return
        }

        if (
          magicDirectionRef.current
        ) {
          regenBlockedUntilRef.current =
            performance.now() +
            MAGIC_REGEN_DELAY
        }

        magicDirectionRef.current =
          null

        setMagicDirection(null)
      },
      []
    )

  /*
  =========================================================
  BARREIRA
  =========================================================
  */

  const activateBarrier =
    useCallback(() => {
      if (
        phaseRef.current !==
        'playing'
      ) {
        return
      }

      if (
        barrierActiveRef.current
      ) {
        return
      }

      if (
        energyRef.current <
        BARRIER_COST
      ) {
        showFeedback(
          'ENERGIA INSUFICIENTE'
        )

        return
      }

      const now =
        performance.now()

      physicalGuardRef.current =
        false

      magicDirectionRef.current =
        null

      setPhysicalGuard(false)
      setMagicDirection(null)

      energyRef.current =
        Math.max(
          0,
          energyRef.current -
          BARRIER_COST
        )

      setEnergy(
        energyRef.current
      )

      barrierActiveRef.current =
        true

      barrierUntilRef.current =
        now +
        BARRIER_DURATION

      regenBlockedUntilRef.current =
        now +
        BARRIER_DURATION +
        MAGIC_REGEN_DELAY

      setBarrierActive(true)

      showFeedback(
        'BARREIRA!'
      )
    }, [showFeedback])

  /*
  =========================================================
  RESET
  =========================================================
  */

  const resetGame =
    useCallback(() => {
      resetProgress()

      lifeRef.current =
        MAX_LIFE

      energyRef.current =
        MAX_ENERGY

      setLife(MAX_LIFE)
      setEnergy(MAX_ENERGY)

      physicalGuardRef.current =
        false

      magicDirectionRef.current =
        null

      barrierActiveRef.current =
        false

      setPhysicalGuard(false)
      setMagicDirection(null)
      setBarrierActive(false)

      barrierUntilRef.current =
        0

      regenBlockedUntilRef.current =
        0

      projectileIdRef.current =
        0

      projectilesRef.current =
        []

      setProjectiles([])

      waveActiveRef.current =
        false

      nextWaveAtRef.current =
        0

      wavesSurvivedRef.current =
        0

      setWaveNumber(0)

      setLastAttack(null)

      lastFrameRef.current =
        null

      setFeedback(null)

      setFeedbackDamage(
        null
      )

      setImpactFlash(false)
    }, [resetProgress])

  const startGame = () => {
    resetGame()

    setCountdown(3)

    setPhase(
      'countdown'
    )
  }

  /*
  =========================================================
  CONTAGEM
  =========================================================
  */

  useEffect(() => {
    if (
      phase !== 'countdown'
    ) {
      return
    }

    if (
      countdown <= 0
    ) {
      const timer =
        window.setTimeout(
          () => {
            setPhase(
              'playing'
            )

            nextWaveAtRef.current =
              performance.now() +
              450
          },
          300
        )

      return () => {
        window.clearTimeout(
          timer
        )
      }
    }

    const timer =
      window.setTimeout(
        () => {
          setCountdown(
            (value) =>
              value - 1
          )
        },
        650
      )

    return () => {
      window.clearTimeout(
        timer
      )
    }
  }, [
    phase,
    countdown,
  ])

  /*
  =========================================================
  PROJÉTEIS
  =========================================================
  */

  const createProjectile =
    useCallback(
      (
        direction:
          AttackDirection,

        wave: number
      ): Projectile | null => {
        const arena =
          arenaRef.current

        if (!arena) {
          return null
        }

        const width =
          arena.clientWidth

        const height =
          arena.clientHeight

        const centerX =
          width / 2

        const centerY =
          height / 2

        const attack =
          randomItem(
            getAttackPool(
              wave
            )
          )

        const size =
          getAttackSize(
            wave
          )

        const scale =
          getSizeScale(
            size
          )

        const multiplier =
          getSizeMultiplier(
            size
          )

        const radius =
          attack.radius *
          scale

        const damage =
          Math.max(
            1,
            Math.round(
              attack.damage *
              multiplier
            )
          )

        const guardDamage =
          Math.max(
            1,
            Math.round(
              attack.guardDamage *
              multiplier
            )
          )

        const margin =
          radius + 45

        let x =
          centerX

        let y =
          centerY

        if (
          direction ===
          'top'
        ) {
          x =
            width *
            (
              0.18 +
              Math.random() *
              0.64
            )

          y =
            -margin
        }

        if (
          direction ===
          'bottom'
        ) {
          x =
            width *
            (
              0.18 +
              Math.random() *
              0.64
            )

          y =
            height +
            margin
        }

        if (
          direction ===
          'left'
        ) {
          x =
            -margin

          y =
            height *
            (
              0.18 +
              Math.random() *
              0.64
            )
        }

        if (
          direction ===
          'right'
        ) {
          x =
            width +
            margin

          y =
            height *
            (
              0.18 +
              Math.random() *
              0.64
            )
        }

        const dx =
          centerX - x

        const dy =
          centerY - y

        const length =
          Math.sqrt(
            dx * dx +
            dy * dy
          ) || 1

        projectileIdRef.current +=
          1

        return {
          id:
            projectileIdRef.current,

          attack,
          direction,
          size,

          x,
          y,

          vx:
            (
              dx /
              length
            ) *
            attack.speed,

          vy:
            (
              dy /
              length
            ) *
            attack.speed,

          radius,
          damage,
          guardDamage,
        }
      },
      []
    )

  /*
  =========================================================
  ONDAS
  =========================================================
  */

  const spawnWave =
    useCallback(() => {
      const wave =
        wavesSurvivedRef.current +
        1

      setWaveNumber(
        wave
      )

      const count =
        getProjectileCount(
          wave
        )

      const availableDirections =
        [...DIRECTIONS]

      const newProjectiles:
        Projectile[] = []

      for (
        let index = 0;
        index < count;
        index += 1
      ) {
        let direction:
          AttackDirection

        if (
          availableDirections.length >
          0
        ) {
          const directionIndex =
            Math.floor(
              Math.random() *
              availableDirections.length
            )

          direction =
            availableDirections[
              directionIndex
            ]

          availableDirections.splice(
            directionIndex,
            1
          )
        } else {
          direction =
            randomItem(
              DIRECTIONS
            )
        }

        const projectile =
          createProjectile(
            direction,
            wave
          )

        if (projectile) {
          newProjectiles.push(
            projectile
          )

          setLastAttack(
            projectile.attack
          )
        }
      }

      if (
        newProjectiles.length ===
        0
      ) {
        nextWaveAtRef.current =
          performance.now() +
          100

        return
      }

      projectilesRef.current =
        newProjectiles

      setProjectiles(
        newProjectiles
      )

      waveActiveRef.current =
        true
    }, [createProjectile])

  /*
  =========================================================
  LOOP PRINCIPAL
  =========================================================
  */

  useEffect(() => {
    if (
      phase !== 'playing'
    ) {
      if (
        animationRef.current !==
        null
      ) {
        cancelAnimationFrame(
          animationRef.current
        )
      }

      lastFrameRef.current =
        null

      return
    }

    const frame = (
      time: number
    ) => {
      const arena =
        arenaRef.current

      if (
        !arena ||
        phaseRef.current !==
          'playing'
      ) {
        return
      }

      if (
        lastFrameRef.current ===
        null
      ) {
        lastFrameRef.current =
          time
      }

      const delta =
        Math.min(
          (
            time -
            lastFrameRef.current
          ) / 1000,
          0.05
        )

      lastFrameRef.current =
        time

      const width =
        arena.clientWidth

      const height =
        arena.clientHeight

      const centerX =
        width / 2

      const centerY =
        height / 2

      /*
      BARREIRA ACABOU
      */

      if (
        barrierActiveRef.current &&
        time >=
          barrierUntilRef.current
      ) {
        barrierActiveRef.current =
          false

        setBarrierActive(
          false
        )
      }

      /*
      REGENERAÇÃO
      */

      const canRegenerate =
        !magicDirectionRef.current &&
        !barrierActiveRef.current &&
        time >=
          regenBlockedUntilRef.current

      if (
        canRegenerate &&
        energyRef.current <
          MAX_ENERGY
      ) {
        energyRef.current =
          Math.min(
            MAX_ENERGY,
            energyRef.current +
              ENERGY_REGEN *
              delta
          )

        setEnergy(
          energyRef.current
        )
      }

      /*
      NOVA ONDA
      */

      if (
        !waveActiveRef.current &&
        projectilesRef.current.length ===
          0 &&
        time >=
          nextWaveAtRef.current
      ) {
        spawnWave()
      }

      /*
      MOVIMENTO / COLISÕES
      */

      if (
        projectilesRef.current.length >
        0
      ) {
        const survivors:
          Projectile[] = []

        let playerDied =
          false

        for (
          const projectile of
          projectilesRef.current
        ) {
          const next = {
            ...projectile,

            x:
              projectile.x +
              projectile.vx *
              delta,

            y:
              projectile.y +
              projectile.vy *
              delta,
          }

          const playerDistance =
            distance(
              next.x,
              next.y,
              centerX,
              centerY
            )

          /*
          BARREIRA
          */

          if (
            barrierActiveRef.current &&
            playerDistance <=
              BARRIER_RADIUS +
              next.radius
          ) {
            showFeedback(
              'BLOQUEADO!'
            )

            continue
          }

          /*
          DEFESA MÁGICA
          */

          if (
            magicDirectionRef.current ===
              projectile.direction &&
            playerDistance <=
              MAGIC_INTERCEPT_DISTANCE +
              next.radius
          ) {
            if (
              energyRef.current >=
              MAGIC_BLOCK_COST
            ) {
              energyRef.current =
                Math.max(
                  0,
                  energyRef.current -
                    MAGIC_BLOCK_COST
                )

              setEnergy(
                energyRef.current
              )

              regenBlockedUntilRef.current =
                time +
                MAGIC_REGEN_DELAY

              showFeedback(
                'DEFESA MÁGICA!'
              )

              continue
            }

            showFeedback(
              'SEM ENERGIA!'
            )
          }

          /*
          PERSONAGEM
          */

          if (
            playerDistance <=
              PLAYER_RADIUS +
              next.radius
          ) {
            const damage =
              physicalGuardRef.current
                ? projectile.guardDamage
                : projectile.damage

            lifeRef.current =
              Math.max(
                0,
                lifeRef.current -
                  damage
              )

            setLife(
              lifeRef.current
            )

            triggerImpact()

            if (
              physicalGuardRef.current
            ) {
              showFeedback(
                'DEFESA FÍSICA',
                damage
              )
            } else {
              showFeedback(
                'ATINGIDO!',
                damage
              )
            }

            if (
              lifeRef.current <= 0
            ) {
              playerDied =
                true
            }

            continue
          }

          survivors.push(
            next
          )
        }

        if (
          playerDied
        ) {
          projectilesRef.current =
            []

          setProjectiles([])

          waveActiveRef.current =
            false

          setPhase(
            'failed'
          )

          return
        }

        projectilesRef.current =
          survivors

        setProjectiles(
          survivors
        )

        /*
        ONDA SOBREVIVIDA
        */

        if (
          waveActiveRef.current &&
          survivors.length ===
            0
        ) {
          waveActiveRef.current =
            false

          wavesSurvivedRef.current +=
            1

          addStack(1)

          if (
            wavesSurvivedRef.current >=
            targetStacks
          ) {
            setPhase(
              'complete'
            )

            return
          }

          nextWaveAtRef.current =
            time +
            WAVE_DELAY
        }
      }

      animationRef.current =
        requestAnimationFrame(
          frame
        )
    }

    animationRef.current =
      requestAnimationFrame(
        frame
      )

    return () => {
      if (
        animationRef.current !==
        null
      ) {
        cancelAnimationFrame(
          animationRef.current
        )
      }

      lastFrameRef.current =
        null
    }
  }, [
    phase,
    addStack,
    showFeedback,
    spawnWave,
    targetStacks,
    triggerImpact,
  ])

  /*
  =========================================================
  DESKTOP
  =========================================================
  */

  useEffect(() => {
    const directions:
      Record<
        string,
        AttackDirection
      > = {
        KeyW: 'top',
        KeyS: 'bottom',
        KeyA: 'left',
        KeyD: 'right',
      }

    const handleKeyDown = (
      event: KeyboardEvent
    ) => {
      if (
        event.code ===
          'ShiftLeft' ||
        event.code ===
          'ShiftRight'
      ) {
        event.preventDefault()

        startPhysicalGuard()

        return
      }

      const direction =
        directions[
          event.code
        ]

      if (direction) {
        event.preventDefault()

        startMagicGuard(
          direction
        )

        return
      }

      if (
        event.code ===
          'Space' &&
        !event.repeat
      ) {
        event.preventDefault()

        activateBarrier()
      }
    }

    const handleKeyUp = (
      event: KeyboardEvent
    ) => {
      if (
        event.code ===
          'ShiftLeft' ||
        event.code ===
          'ShiftRight'
      ) {
        event.preventDefault()

        stopPhysicalGuard()

        return
      }

      const direction =
        directions[
          event.code
        ]

      if (direction) {
        event.preventDefault()

        stopMagicGuard(
          direction
        )
      }
    }

    const handleBlur = () => {
      stopPhysicalGuard()
      stopMagicGuard()
    }

    window.addEventListener(
      'keydown',
      handleKeyDown
    )

    window.addEventListener(
      'keyup',
      handleKeyUp
    )

    window.addEventListener(
      'blur',
      handleBlur
    )

    return () => {
      window.removeEventListener(
        'keydown',
        handleKeyDown
      )

      window.removeEventListener(
        'keyup',
        handleKeyUp
      )

      window.removeEventListener(
        'blur',
        handleBlur
      )
    }
  }, [
    activateBarrier,
    startMagicGuard,
    startPhysicalGuard,
    stopMagicGuard,
    stopPhysicalGuard,
  ])

  const exitTraining = () => {
    physicalGuardRef.current =
      false

    magicDirectionRef.current =
      null

    barrierActiveRef.current =
      false

    projectilesRef.current =
      []

    returnToMenu()
  }

  /*
  =========================================================
  ESCUDO MÁGICO VISUAL
  =========================================================
  */

  const magicShieldStyle = () => {
    if (
      magicDirection ===
      'left'
    ) {
      return {
        left:
          'calc(50% - 92px)',
        top: '50%',
        transform:
          'translate(-50%, -50%)',
      }
    }

    if (
      magicDirection ===
      'right'
    ) {
      return {
        left:
          'calc(50% + 92px)',
        top: '50%',
        transform:
          'translate(-50%, -50%)',
      }
    }

    if (
      magicDirection ===
      'top'
    ) {
      return {
        left: '50%',
        top:
          'calc(50% - 92px)',
        transform:
          'translate(-50%, -50%) rotate(90deg)',
      }
    }

    return {
      left: '50%',
      top:
        'calc(50% + 92px)',
      transform:
        'translate(-50%, -50%) rotate(90deg)',
    }
  }

  return (
    <main
      className="
        min-h-[100dvh]
        overflow-hidden
        overscroll-none
        select-none
        bg-[#050706]
        text-white
      "
    >

      <div
        className="
          mx-auto
          flex
          h-[100dvh]
          w-full
          max-w-md
          flex-col
          px-3
          pb-[max(10px,env(safe-area-inset-bottom))]
          pt-[max(10px,env(safe-area-inset-top))]
          sm:max-w-lg
          lg:max-w-2xl
        "
      >

        {/* =================================================
            HUD SUPERIOR
        ================================================= */}

        <header
          className="
            shrink-0
          "
        >

          <div
            className="
              flex
              items-center
              gap-3
            "
          >

            <button
              type="button"
              onClick={
                exitTraining
              }

              className="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-2xl
                border
                border-white/10
                bg-white/5
                active:scale-95
              "
            >
              <ArrowLeft
                size={20}
              />
            </button>

            <div
              className="
                min-w-0
                flex-1
              "
            >

              <div
                className="
                  flex
                  items-center
                  gap-2
                "
              >

                <Shield
                  size={19}
                  className="
                    text-emerald-400
                  "
                />

                <h1
                  className="
                    text-lg
                    font-black
                  "
                >
                  Vigor
                </h1>

              </div>

              <p
                className="
                  text-[11px]
                  text-white/35
                "
              >
                Resistência Extrema
              </p>

            </div>

            <div
              className="
                text-right
              "
            >

              <p
                className="
                  text-[9px]
                  font-black
                  uppercase
                  tracking-widest
                  text-white/30
                "
              >
                Ondas
              </p>

              <p
                className="
                  text-lg
                  font-black
                "
              >
                {currentStacks}

                <span
                  className="
                    text-white/30
                  "
                >
                  /{targetStacks}
                </span>
              </p>

            </div>

          </div>

          <div
            className="
              mt-3
              h-1.5
              overflow-hidden
              rounded-full
              bg-white/10
            "
          >

            <motion.div
              className="
                h-full
                rounded-full
                bg-emerald-400
              "

              animate={{
                width:
                  `${progress}%`,
              }}
            />

          </div>

        </header>

        {/* =================================================
            READY / COUNTDOWN
        ================================================= */}

        <section
          className="
            relative
            flex
            min-h-0
            flex-1
            flex-col
            pt-3
          "
        >

          <AnimatePresence
            mode="wait"
          >

            {phase ===
              'ready' && (
              <motion.div
                key="ready"

                initial={{
                  opacity: 0,
                  y: 12,
                }}

                animate={{
                  opacity: 1,
                  y: 0,
                }}

                exit={{
                  opacity: 0,
                }}

                className="
                  my-auto
                  flex
                  w-full
                  flex-col
                  items-center
                  text-center
                "
              >

                <div
                  className="
                    relative
                    flex
                    h-28
                    w-28
                    items-center
                    justify-center
                  "
                >

                  <div
                    className="
                      absolute
                      inset-0
                      rounded-full
                      border
                      border-emerald-400/20
                      bg-emerald-400/5
                    "
                  />

                  <div
                    className="
                      absolute
                      inset-3
                      rounded-full
